# Environment
ENVIRONMENT=development
DEBUG=true

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=AI Agents
VITE_APP_URL=http://localhost:3000

# Backend
BAckend_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=ai_agents

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINCONE_API_KEY=your-pinecone-api-key
PINCONE_ENVIRONMENT=your-pinecone-environment
PINCONE_INDEX=ai-agents-index

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=ai-agents-bucket
AWS_S3_REGION=us-east-1

# MinIO (Alternative to S3)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-agents

# Storage Type: 's3' or 'minio'
STORAGE_TYPE=minio

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# PDF Processing
MAX_PDF_SIZE=52428800
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=200

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
